<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include ('partials/head.ejs') %>
</head>
<body>
    <%- include ('partials/nav.ejs') %>

    <div class="container">
        <div class="row mt-4">
            <div class="col">
                <h1>Mes albums</h1>
                <a href="/albums/create" class="btn btn-primary mb-3">Nouvel album</a>
            </div>
        </div>
        <div class="row">
            <div class="col col-xs-12 col-sm-4">
                <% albums.forEach((album) => { %>
                    <ul class="list-group">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <a href="#"> <%= album.title %> </a>
                            <a href="#" class="--bs-danger">Supprimer</a>
                        </li>
                    </ul>
                <% }) %>
            </div>
        </div>
    </div>

    <%- include ('partials/scripts.ejs') %>
</body>
</html>