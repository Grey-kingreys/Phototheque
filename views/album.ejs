<!DOCTYPE html>
<html lang="fr">
<head>
    <%- include ('partials/head.ejs') %>
</head>
<body>
    <%- include ('partials/nav.ejs') %> 

    <div class="container">
        <div class="row mt-4">
            <div class="col">
                <a href="/albums" class="mt-4">Retour</a>
                <h1> <%= album.title %> </h1>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            Ajouter un album
                        </h5>
                        <form action="/albums/<%= album._id %>" method="post" class="form-inline" enctype="multipart/form-data">
                            <input type="file" name="image" class="form-control-file">
                            <button type="submit" class="btn btn-primary mb-3">Ajouter</button>
                        </form>
                        <% if (errors.length) { %>
                        <div class="alert alert-danger mt-4 mb-2" role="alert">
                            <%= errors[0] %>
                        </div>
                    <% } %>
                    </div>
                </div>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-4 g-4">
            <% album.images.forEach((image, index) => { %>
                <div class="col">
                    <div class="card">
                        <img src="/upload/<%= album._id %>/<%= image %>" alt="<%= image %>" class="card-img-top">
                        <div class="card-body">
                            <h5><%= index %>  <%= image %></h5>
                            <a href="/albums/<%= album._id %>/delete/<%= index %>">Supprimer</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <%- include ('partials/scripts.ejs') %>
</body>
</html>